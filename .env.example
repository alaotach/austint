# Intelligent OSINT Environment Configuration

# Custom User-Agent header for public API queries
OSINT_USER_AGENT=IntelligentOSINT-Agent/1.0 (Educational Academic Project; contact: student@university.edu)

# Operational limits
DEFAULT_MAX_DEPTH=2
DEFAULT_MAX_TOOL_CALLS=15
DEFAULT_CONFIDENCE_DECAY=0.8
DEFAULT_ACCEPT_THRESHOLD=0.5

# Rate limits (delay in seconds between requests for polite crawling)
NOMINATIM_REQUEST_DELAY=1.0
CRTSH_REQUEST_TIMEOUT=15.0
WIKIDATA_REQUEST_TIMEOUT=10.0

# LLM Configuration (Step 4)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
MAX_LLM_CALLS=20

# Optional Threat Intel Free-Tier API Keys
VIRUSTOTAL_API_KEY=
OTX_API_KEY=
ABUSEIPDB_API_KEY=
OPENSANCTIONS_API_KEY=
